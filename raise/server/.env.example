# 复制为 .env 后修改。npm start 会自动读取 .env

PORT=8787
# 对外访问地址（支付回调、支付后跳转、微信授权都会用到），必须是 https 正式域名
PUBLIC_BASE_URL=http://localhost:8787
# 部署在 Nginx 等反向代理之后时设为 1，以便取到用户真实 IP（微信 H5 支付需要）
TRUST_PROXY=0
# 页面与接口不同域时填写页面的 Origin，例如 https://www.example.com
CORS_ORIGIN=

# 价格（单位：分）。ORIGINAL_PRICE_FEN 为划线价，不需要可设为 0
PRICE_FEN=2990
ORIGINAL_PRICE_FEN=9900

# 支付方式：mock（测试，点击即视为支付成功，切勿用于生产）或 wechat
PAY_PROVIDER=mock

# ---- 微信支付 API v3（PAY_PROVIDER=wechat 时必填）----
WECHAT_MCHID=
# 服务号 AppID（H5 支付与 JSAPI 支付共用；需在商户平台与该 AppID 完成绑定）
WECHAT_APPID=
# 服务号 AppSecret（JSAPI 支付获取 openid 用）
WECHAT_APP_SECRET=
# 商户 API 证书序列号 与 私钥文件 apiclient_key.pem
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=./keys/apiclient_key.pem
WECHAT_API_V3_KEY=
# 微信支付公钥（商户平台 → API 安全 → 微信支付公钥）与公钥 ID（PUB_KEY_ID_ 开头）
WECHAT_PLATFORM_PUBLIC_KEY_PATH=./keys/pub_key.pem
WECHAT_PLATFORM_PUBLIC_KEY_ID=
# 已开通的产品：H5 支付（外部浏览器）、JSAPI 支付（微信内）
WECHAT_H5_ENABLED=0
WECHAT_JSAPI_ENABLED=1

# ---- AI 深度定制（可选）----
# 配置后，付费用户会额外获得一份结合其补充情况的 AI 定制内容
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# “已帮助 N 人”至少达到多少才展示；不足时展示公开调研数据
SOCIAL_MIN_DISPLAY=30
# 运营数据接口 /api/admin/stats 的访问令牌
ADMIN_TOKEN=
DATA_DIR=data
